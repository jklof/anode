# Python virtual environment in ./na/
na/

# Python cache directories
__pycache__/
*.pyc
*.dylib
*.so
*.dll

# Exported neural vocoder weights (built offline via tools/export_vocos_onnx.py;
# dynamo export splits weights into a separate .onnx.data file)
models/*.onnx
models/*.onnx.data

# audio.cpp native runtime (fetched via tools/audiocpp/fetch_audiocpp.py)
tools/audiocpp/bin/

# Local CMake configure/build tree (VS Code cmake.sourceDirectory points at
# cpp/, so the extension configures in cpp/build/)
cpp/build/

# YuE2 GGUF weights + sidecars (fetched via tools/audiocpp/fetch_yue2_gguf.py);
# per-generation outputs are local provenance records, never committed.
models/YuE2-3B-GGUF/*.gguf
models/YuE2-3B-GGUF/sidecars/
models/YuE2-3B-GGUF/outputs/

# YuE2 torch weights + tokenizer (fetched via tools/audiocpp/fetch_yue2_torch.py
# or tools/yue2_torch/fetch.py); per-generation outputs are local provenance
# records, never committed.
models/YuE2-Torch/*.safetensors
models/YuE2-Torch/*.tiktoken
models/YuE2-Torch/outputs/

# SheetSage2 GGUF weights (fetched via tools/audiocpp/fetch_sheetsage2_gguf.py);
# per-transcription outputs are local provenance records, never committed.
models/SheetSage2-GGUF/*.gguf
models/SheetSage2-GGUF/outputs/

# BS-RoFormer GGUF weights (fetched via tools/audiocpp/fetch_bs_roformer_gguf.py);
# per-separation outputs are local provenance records, never committed.
models/BS-RoFormer-ep368-GGUF/*.gguf
models/BS-RoFormer-ep368-GGUF/outputs/

# Qwen3 ASR + forced-aligner GGUF weights (fetched via
# tools/audiocpp/fetch_qwen3_asr_gguf.py and fetch_qwen3_align_gguf.py);
# per-transcription outputs are local provenance records, never committed.
models/Qwen3-ASR-GGUF/*.gguf
models/Qwen3-ASR-GGUF/outputs/
models/Qwen3-ForcedAligner-GGUF/*.gguf
models/Qwen3-ForcedAligner-GGUF/outputs/
models/Qwen3-ForcedAligner-0.6B-GGUF/*.gguf
models/Qwen3-ForcedAligner-0.6B-GGUF/outputs/

# Silero VAD asset (fetched via tools/audiocpp/fetch_silero_vad.py).
models/Silero-VAD/*.safetensors

# Supertonic 3 ONNX + voice styles (fetched via tools/supertonic3/fetch.py);
# per-generation profiles/outputs are local provenance records, never
# committed. Documentation (tools/supertonic3/README.md) stays trackable.
models/Supertonic3/onnx/
models/Supertonic3/voice_styles/
models/Supertonic3/profiles/
models/Supertonic3/outputs/
models/Supertonic3/_dl/
models/Supertonic3/LICENSE

# Whistle realtime STT weights + native engine (fetched via
# tools/whistle/fetch.py). Everything under here is fetched at runtime only:
# the 17 MB Apache-2.0 .cact, the platform engine wheel, the extracted
# libneedle3 and the per-session transcripts/outputs.
models/Whistle/

#inputs
inputs/

# Fitted-lyrics keeps (Lyric Fitter node): local provenance records,
# never committed.
outputs/