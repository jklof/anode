# Python virtual environment in ./na/
na/

# Python cache directories
__pycache__/
*.pyc
*.dylib
*.so
*.dll

# Exported neural vocoder weights (built offline via tools/export_vocos_onnx.py;
# dynamo export splits weights into a separate .onnx.data file)
models/*.onnx
models/*.onnx.data

# audio.cpp native runtime (fetched via tools/audiocpp/fetch_audiocpp.py)
tools/audiocpp/bin/

# Local CMake configure/build tree (VS Code cmake.sourceDirectory points at
# cpp/, so the extension configures in cpp/build/)
cpp/build/

# YuE2 GGUF weights + sidecars (fetched via tools/audiocpp/fetch_yue2_gguf.py);
# per-generation outputs are local provenance records, never committed.
models/YuE2-3B-GGUF/*.gguf
models/YuE2-3B-GGUF/sidecars/
models/YuE2-3B-GGUF/outputs/

# YuE2 torch weights + tokenizer (fetched via tools/audiocpp/fetch_yue2_torch.py
# or tools/yue2_torch/fetch.py); per-generation outputs are local provenance
# records, never committed.
models/YuE2-Torch/*.safetensors
models/YuE2-Torch/*.tiktoken
models/YuE2-Torch/outputs/

# SheetSage2 GGUF weights (fetched via tools/audiocpp/fetch_sheetsage2_gguf.py);
# per-transcription outputs are local provenance records, never committed.
models/SheetSage2-GGUF/*.gguf
models/SheetSage2-GGUF/outputs/

#inputs
inputs/

# Fitted-lyrics keeps (Lyric Fitter node): local provenance records,
# never committed.
outputs/