# Python virtual environment in ./na/
na/

# Python cache directories
__pycache__/
*.pyc
*.dylib
*.so
*.dll

# Exported neural vocoder weights (built offline via tools/export_vocos_onnx.py;
# dynamo export splits weights into a separate .onnx.data file)
models/*.onnx
models/*.onnx.data

# audio.cpp native runtime (fetched via tools/audiocpp/fetch_audiocpp.py)
tools/audiocpp/bin/

# YuE2 GGUF weights + sidecars (fetched via tools/audiocpp/fetch_yue2_gguf.py);
# per-generation outputs are local provenance records, never committed.
models/YuE2-3B-GGUF/*.gguf
models/YuE2-3B-GGUF/sidecars/
models/YuE2-3B-GGUF/outputs/